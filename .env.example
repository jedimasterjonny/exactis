# The Postgres the accounts live in. A Neon connection string, with the
# pooled host, since the app reaches it over HTTP a statement at a time.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Seals the session cookie. At least 32 characters; a new value signs
# everyone out. openssl rand -base64 32 makes one.
SESSION_PASSWORD=
# The one password that signs in, as bun run hash-password writes it.
APP_PASSWORD_HASH=

# Set to 1 to add a sign-in that asks no password to the login screen, for
# an agent that types no credentials. Read only outside a production build,
# so it does nothing on Vercel; leave it out of .env.local on a machine
# whose dev server anyone else can reach.
# APP_DEV_SIGN_IN=1
