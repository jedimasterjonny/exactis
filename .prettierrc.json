{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsxSingleQuote": false,
  "objectWrap": "collapse",
  "plugins": ["prettier-plugin-tailwindcss"],
  "printWidth": 80,
  "quoteProps": "as-needed",
  "semi": true,
  "singleAttributePerLine": false,
  "singleQuote": false,
  "tabWidth": 2,
  "tailwindFunctions": ["cn", "cva"],
  "tailwindStylesheet": "./src/app/globals.css",
  "trailingComma": "all",
  "useTabs": false
}
