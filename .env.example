# The Postgres the accounts live in. A Neon connection string, with the
# pooled host, since the app reaches it over HTTP a statement at a time.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Seals the session cookie. At least 32 characters; a new value signs
# everyone out. openssl rand -base64 32 makes one.
SESSION_PASSWORD=
# The one password that signs in, as bun run hash-password writes it:
# scrypt's cost, then the salt and the key in hex. A hash made before the
# cost was raised, plain salt:key, fails sign-in by name; make it again. On
# a development machine it is the hash of a throwaway, written on the line
# above it as "# password: ..." so an agent reads that one line to sign in.
APP_PASSWORD_HASH=

# The Land Registry region the house price index is pulled for, as the id
# the Registry gives it in an address (landregistry.data.gov.uk, UKHPI).
HOUSE_PRICE_REGION=
